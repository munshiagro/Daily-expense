rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ⚠️ নিচের লেখাটির জায়গায় তোমার অ্যাডমিন UID বসাও
    // (অ্যাপের "সেটিংস" ট্যাবে নিজের UID দেখা যায়)
    function isAdmin() {
      return signedIn() && request.auth.uid == "PASTE_ADMIN_UID_HERE";
    }

    function isApprovedUser() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.status == "approved";
    }

    // ব্যবহারকারীর প্রোফাইল ও অনুমোদনের অবস্থা
    match /profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // নিজের আবেদন শুধু "pending" হিসেবেই তৈরি করা যাবে
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "name", "email", "status", "createdAt"])
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time;
      // অ্যাডমিন সব বদলাতে পারে; ব্যবহারকারী শুধু নিজের নাম
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 60);
      allow delete: if isAdmin();
    }

    // হিসাবের ডেটা: শুধু নিজের, এবং অনুমোদিত + ইমেইল যাচাই করা ব্যবহারকারী (অ্যাডমিন সরাসরি)
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId
        && (isAdmin() || isApprovedUser());
    }
  }
}
